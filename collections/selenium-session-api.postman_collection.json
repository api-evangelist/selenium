  "info": {
    "_postman_id": "9075ba2c-b93b-4944-90ea-d2faa0eb59ac",
    "name": "Selenium WebDriver (W3C Wire Protocol) Cookies Session API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Selenium WebDriver implements the W3C WebDriver protocol — a platform- and language-neutral HTTP wire protocol used by out-of-process programs to remotely instruct browsers. This OpenAPI definition lists common endpoints exposed by a WebDriver remote end (e.g. a Selenium Grid node, selenium-standalone, or a browser-specific driver such as chromedriver/geckodriver). No authentication is defined by the W3C protocol itself; deployments typically front the endpoint with a reverse proxy or run on a private network.\n\nContact Support:\n Name: Selenium",
      "type": "text/plain"
    }
  }
